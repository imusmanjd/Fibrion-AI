# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
_check.py

# Dependencies
node_modules/

# Next.js
.next/
out/

# Local environment variables
.env
.env.local
.env.*.local

# Local SQLite dev database (DATABASE_URL falls back to this when
# unset - never commit it, it's a throwaway local file)
*.db
*.db-journal

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# --- Data & generated output ---
# Never commit real production data, generated reports, or per-run
# temp artifacts. The leading **/ matters: these folders live under
# backend/, not at the repo root where this .gitignore sits, and a
# pattern with a slash in the middle (like "data/**/*.csv") only
# matches a data/ folder AT the .gitignore's own location without it.
**/data/**/*.csv
**/data/**/*.xlsx
**/outputs/reports/**
**/outputs/tmp/
!**/data/raw/.gitkeep
!**/data/test/.gitkeep
!**/outputs/reports/.gitkeep

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Logs ---
*.log