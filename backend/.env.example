# --- LLM API ---
OPENROUTER_API_KEY=
DEFAULT_MODEL_FAST=anthropic/claude-haiku-4-5
DEFAULT_MODEL_REASONING=anthropic/claude-sonnet-5
GROQ_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Database ---
# Falls back to a local SQLite file if unset - fine for quick local
# dev, but use a real Postgres URL (e.g. from Neon) for anything
# beyond that. Format: postgresql://user:password@host/dbname
DATABASE_URL=

# --- Auth ---
# Any long random string - generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# --- Email (Gmail SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# --- App ---
FIBRION_ENV=development
LOG_LEVEL=INFO
VERIFICATION_MAX_RETRIES=1

# --- Langsmith ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fibrion